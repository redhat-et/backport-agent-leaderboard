# crate/crate backport test environment
# JDK 25 (Temurin) + Maven wrapper — matches key-repos.md requirements
#
# Build:  podman build -t crate-backport-test:latest .
# Run:    podman run --rm -v /path/to/crate:/workspace:z crate-backport-test:latest

FROM eclipse-temurin:25-jdk

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    python3 \
    python3-venv \
    python3-pip \
    openssl \
    curl \
    && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/opt/java/openjdk
ENV PATH=$JAVA_HOME/bin:$PATH
ENV MAVEN_OPTS="-Xmx2g -XX:+TieredCompilation"

WORKDIR /workspace

# Default: run unit tests via Maven wrapper
# Override when running specific tests:
#   podman run ... crate-backport-test:latest ./mvnw test -pl server -Dtest=MyTest
CMD ["./mvnw", "test", "-DskipBlackboxTests=true", "-q"]
