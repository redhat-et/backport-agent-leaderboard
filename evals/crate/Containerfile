# crate/crate backport test environment
# JDK 25 (Temurin) + Maven wrapper — matches key-repos.md requirements
#
# Build:  podman build -t crate-backport-test:latest .
# Run:    podman run --rm -v /path/to/crate:/workspace:z crate-backport-test:latest

FROM eclipse-temurin:24-jdk

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    patch \
    python3 \
    python3-venv \
    python3-pip \
    openssl \
    curl \
    && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/opt/java/openjdk
ENV PATH=$JAVA_HOME/bin:$PATH
ENV MAVEN_OPTS="-Xmx2g -XX:+TieredCompilation"
# OpenShift runs as a random non-root UID with no home dir; set HOME to /tmp
# so Maven writes ~/.m2 to /tmp/.m2 (always writable)
ENV HOME=/tmp

# Create a world-writable workspace so OpenShift's random UID can write to it
RUN mkdir -p /workspace && chmod 777 /workspace

# /tmp is world-writable (1777) — toolchains.xml is written fresh at job runtime
# to avoid root-ownership issues in OpenShift's random-UID environment.

# Bake in the Raw Claude backport script
COPY generic_claude_backport.py /opt/generic_claude_backport.py

WORKDIR /workspace

CMD ["bash"]
