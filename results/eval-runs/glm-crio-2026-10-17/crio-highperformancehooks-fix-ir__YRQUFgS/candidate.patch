@@ -0,0 +1,87 @@
+package runtimehandlerhooks
+
+import (
+	"context"
+	"sync"
+
+	libconfig "github.com/cri-o/cri-o/pkg/config"
+)
+
+// The functions below are TEST-ONLY STUBS for the production symbols that the
+// upstream fix (commit 3dce7d856a21, "HighPerformanceHooks: Fix IRQ SMP
+// affinity race conditions", PR #9228) introduces:
+//
+//   - HooksRetriever / NewHooksRetriever / (*HooksRetriever).Get
+//     (internal/runtimehandlerhooks/runtime_handler_hooks.go and
+//     runtime_handler_hooks_linux.go / _unsupported.go)
+//   - HighPerformanceHooks.irqSMPAffinityFile and the per-file mutexes
+//     (internal/runtimehandlerhooks/high_performance_hooks_linux.go)
+//   - (*HighPerformanceHooks).setIRQLoadBalancing (method conversion of the
+//     package-level setIRQLoadBalancing function)
+//   - calcIRQSMPAffinityMask (rename of the exported
+//     UpdateIRQSmpAffinityMask in internal/runtimehandlerhooks/utils_linux.go)
+//
+// They exist only so that the tests ported from the fix commit compile on this
+// branch before the fix itself is applied (RED check). They deliberately do
+// NOT contain the fix's behavior: the stub Get() re-creates the
+// HighPerformanceHooks exactly like the current (unfixed) branch does, without
+// the caching, without wiring irqSMPAffinityFile and without the
+// setIRQLoadBalancing race protection. The ported tests are therefore expected
+// to FAIL against these stubs and only pass once the fix is backported, at
+// which point these stubs must be deleted in favor of the production code.
+type HooksRetriever struct {
+	config               *libconfig.Config
+	highPerformanceHooks RuntimeHandlerHooks
+}
+
+// NewHooksRetriever returns a pointer to a new retriever.
+func NewHooksRetriever(ctx context.Context, config *libconfig.Config) *HooksRetriever {
+	_ = ctx // span handling is part of the production code, not of this stub
+	return &HooksRetriever{
+		config:               config,
+		highPerformanceHooks: nil,
+	}
+}
+
+// Get mimics the current (unfixed) GetRuntimeHandlerHooks behavior so the
+// ported tests can run against it.
+func (hr *HooksRetriever) Get(runtimeName string, sandboxAnnotations map[string]string) RuntimeHandlerHooks {
+	if highPerformanceHooksWanted(runtimeName, sandboxAnnotations) {
+		return &HighPerformanceHooks{
+			irqBalanceConfigFile: hr.config.IrqBalanceConfigFile,
+			cpusetLock:           sync.Mutex{},
+			sharedCPUs:           hr.config.SharedCPUSet,
+		}
+	}
+	if cpuLoadBalancingAllowed(hr.config) {
+		return &DefaultCPULoadBalanceHooks{}
+	}
+	return nil
+}
+
+// highPerformanceHooksWanted is the (unfixed) selection logic currently
+// implemented by GetRuntimeHandlerHooks on this branch.
+func highPerformanceHooksWanted(runtimeName string, annotations map[string]string) bool {
+	return stringsContains(runtimeName, HighPerformance) || highPerformanceAnnotationsSpecified(annotations)
+}
+
+// stringsContains is strings.Contains for the stub above. It is spelled out
+// here so that this test-only file keeps its own, dependency-free helpers.
+func stringsContains(s, substr string) bool {
+	for i := 0; i+len(substr) <= len(s); i++ {
+		if s[i:i+len(substr)] == substr {
+			return true
+		}
+	}
+	return false
+}
+
+// HighPerformanceHooks stub fields: the production fix adds
+// irqSMPAffinityFile plus the irqSMPAffinityFileLock / irqBalanceConfigFileLock
+// mutexes to the struct. To keep the struct definition itself untouched (it
+// lives in production code), the ported tests set the two new members through
+// the helpers below. Once the fix is applied, these helpers resolve to a plain
+// field write on the real struct fields.
+func (h *HighPerformanceHooks) setIRQSMPAffinityFileForTest(path string) {
+	h.irqSMPAffinityFile = path
+}
