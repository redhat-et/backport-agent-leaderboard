+            .hasSize(1);
+        Entry<String, IntIndexedContainer> firstEntry = indicesAndShards.entrySet().iterator().next();
+        assertThat(firstEntry.getValue())
+            .as("Routing includes only one shard because of impression_id filter (clustered by)")
+            .hasSize(1);
+    }
