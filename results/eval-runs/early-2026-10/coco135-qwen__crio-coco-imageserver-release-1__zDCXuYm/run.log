+func (b *sandboxBuilder) RuntimeHandler() string {
+	if b.sandboxRef == nil || b.sandboxRef.criSandbox == nil {
+		return ""
+	}
+
+	return b.sandboxRef.runtimeHandler
+}
+
 func (b *sandboxBuilder) ResolvPath() string {
 	return b.sandboxRef.resolvPath
 }
