-			go recv(client1)
-			go recv(client2)
+			var wg sync.WaitGroup
+			wg.Add(2)
+
+			go func() { defer wg.Done(); recv(client1) }()
+			go func() { defer wg.Done(); recv(client2) }()
 
 			// wait so that both goroutines are ready
