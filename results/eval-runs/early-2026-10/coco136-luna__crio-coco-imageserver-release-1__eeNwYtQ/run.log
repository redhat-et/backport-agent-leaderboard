@@ -272,3 +277,139 @@ func (s *Store) getImageReference(nameOrDigest string) (types.ImageReference, er
 
 	return ref, nil
 }
+
+// PullManifestOnly pulls and persists an image manifest and config without downloading layers.
+func (s *Store) PullManifestOnly(ctx context.Context, ref types.ImageReference, opts *libimage.CopyOptions) (*digest.Digest, error) {
+	sys := s.systemContext
+	if sys == nil {
+		sys = &types.SystemContext{}
+	}
+	if opts != nil && (opts.Username != "" || opts.AuthFilePath != "") {
+		cp := *sys
+		if opts.Username != "" {
+			cp.DockerAuthConfig = &types.DockerAuthConfig{Username: opts.Username, Password: opts.Password}
+		}
+		if opts.AuthFilePath != "" {
+			cp.AuthFilePath = opts.AuthFilePath
+		}
+		sys = &cp
+	}
+	src, err := ref.NewImageSource(ctx, sys)
+	if err != nil {
+		return nil, err
+	}
+	defer src.Close()
+	mb, mime, err := src.GetManifest(ctx, nil)
+	if err != nil {
+		return nil, err
+	}
+	if manifest.MIMETypeIsMultiImage(mime) {
+		l, e := manifest.ListFromBlob(mb, mime)
+		if e != nil {
+			return nil, e
+		}
+		d, e := l.ChooseInstance(sys)
+		if e != nil {
+			return nil, e
+		}
+		mb, mime, err = src.GetManifest(ctx, &d)
+		if err != nil {
+			return nil, err
+		}
+	}
+	parsed, err := manifest.FromBlob(mb, mime)
+	if err != nil {
+		return nil, err
+	}
+	ci := parsed.ConfigInfo()
+	ir, err := layout.NewReference(s.Store.RootPath(), ref.DockerReference().String())
+	if err != nil {
+		return nil, err
+	}
+	dst, err := ir.NewImageDestination(ctx, sys)
+	if err != nil {
+		return nil, err
+	}
+	defer dst.Close()
+	rc, _, err := src.GetBlob(ctx, types.BlobInfo{Digest: ci.Digest, Size: ci.Size}, none.NoCache)
+	if err != nil {
+		return nil, err
+	}
+	defer rc.Close()
+	if _, err = dst.PutBlob(ctx, rc, types.BlobInfo{Digest: ci.Digest, Size: ci.Size}, none.NoCache, true); err != nil {
+		return nil, err
+	}
+	if err = dst.PutManifest(ctx, mb, nil); err != nil {
+		return nil, err
+	}
+	if err = dst.Commit(ctx, &manifestOnlyImage{ref: ir, blob: mb, mime: mime}); err != nil {
+		return nil, err
+	}
+	d := digest.FromBytes(mb)
+	return &d, nil
+}
+
+type manifestOnlyImage struct {
+	ref  types.ImageReference
+	blob []byte
+	mime string
+}
+
+func (m *manifestOnlyImage) Reference() types.ImageReference { return m.ref }
+func (m *manifestOnlyImage) Manifest(context.Context) ([]byte, string, error) {
+	return m.blob, m.mime, nil
+}
+func (m *manifestOnlyImage) Signatures(context.Context) ([][]byte, error) { return nil, nil }
+func (s *Store) ImageSource(ctx context.Context, dgst string) (types.ImageSource, error) {
+	arts, err := s.List(ctx)
+	if err != nil {
+		return nil, err
+	}
+	for _, a := range arts {
+		if strings.HasPrefix(a.Digest().Encoded(), dgst) {
+			r, e := s.impl.LayoutNewReference(a.RootPath(), a.Reference())
+			if e != nil {
+				return nil, e
+			}
+			return s.impl.NewImageSource(ctx, r, s.systemContext)
+		}
+	}
+	return nil, fmt.Errorf("no artifact found with digest %q", dgst)
+}
+func (s *Store) PullConfig(ctx context.Context, refStr string) (*specs.Image, error) {
+	a, err := s.Status(ctx, refStr)
+	if err != nil {
+		return nil, err
+	}
+	r, err := s.impl.LayoutNewReference(a.RootPath(), a.Reference())
+	if err != nil {
+		return nil, err
+	}
+	src, err := s.impl.NewImageSource(ctx, r, s.systemContext)
+	if err != nil {
+		return nil, err
+	}
+	defer s.impl.CloseImageSource(src)
+	top := image.UnparsedInstance(src, nil)
+	mb, mime, err := top.Manifest(ctx)
+	if err != nil {
+		return nil, err
+	}
+	inst := top
+	if manifest.MIMETypeIsMultiImage(mime) {
+		l, e := manifest.ListFromBlob(mb, mime)
+		if e != nil {
+			return nil, e
+		}
+		d, e := l.ChooseInstance(s.systemContext)
+		if e != nil {
+			return nil, e
+		}
+		inst = image.UnparsedInstance(src, &d)
+	}
+	im, err := image.FromUnparsedImage(ctx, s.systemContext, inst)
+	if err != nil {
+		return nil, err
+	}
+	return im.OCIConfig(ctx)
+}

