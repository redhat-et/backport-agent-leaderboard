+	# leave the artifact store in a valid state.
+	local ctr2_id
+	ctr2_id=$(crictl create --with-pull "$pod_id" "$TESTDATA"/container_sleep.json "$TESTDATA"/sandbox_config.json)
+	[[ -n "$ctr2_id" ]]
+
+	crictl start "$ctr2_id"
+	cleanup "$ctr2_id" "$pod_id"
+}
