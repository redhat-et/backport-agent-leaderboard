 }
 
 // New creates a new OCI artifact data store.
@@ -43,8 +52,10 @@ func New(rootPath string, systemContext *types.SystemContext) (*Store, error) {
 	}
 
 	return &Store{
-		store: artStore,
-		impl:  &defaultImpl{},
+		store:         artStore,
