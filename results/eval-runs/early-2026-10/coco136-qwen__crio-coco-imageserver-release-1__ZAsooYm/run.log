+	"go.podman.io/image/v5/pkg/blobinfocache/none"
 	"go.podman.io/image/v5/types"
 
 	"github.com/cri-o/cri-o/internal/log"
@@ -37,6 +43,7 @@ func (a *ArtifactData) Data() []byte {
 type Store struct {
