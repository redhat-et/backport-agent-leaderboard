 	"github.com/cri-o/cri-o/internal/log"
@@ -29,8 +36,10 @@ func (a *ArtifactData) Data() []byte {
 // Store handles pulling artifact data and reading blobs using the podman
 // libartifact store directly.
 type Store struct {
-	store LibartifactStore
-	impl  Impl
+	store         LibartifactStore
+	impl          Impl
+	storePath     string
